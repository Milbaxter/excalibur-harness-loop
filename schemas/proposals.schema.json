{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Excalibur meta-review proposals",
  "type": "object",
  "required": ["review_id", "reviewer", "system_findings", "plugin_audits", "new_candidates", "requeue", "config_changes", "questions_for_human"],
  "additionalProperties": false,
  "properties": {
    "review_id": { "type": "integer", "minimum": 0 },
    "reviewer": { "type": "string", "description": "e.g. supervisor:<model> or fallback-deepseek-pro" },
    "reviewed_at": { "type": "string" },
    "system_findings": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["area", "finding", "severity"],
        "additionalProperties": false,
        "properties": {
          "area": { "type": "string", "enum": ["evaluator", "acceptance", "harness", "budget", "controller", "other"] },
          "finding": { "type": "string" },
          "severity": { "type": "string", "enum": ["low", "med", "high"] },
          "evidence": { "type": "string" }
        }
      }
    },
    "plugin_audits": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "verdict", "reason"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string" },
          "verdict": { "type": "string", "enum": ["general", "suspicious", "hack"] },
          "reason": { "type": "string" }
        }
      }
    },
    "new_candidates": {
      "type": "array",
      "maxItems": 8,
      "items": {
        "type": "object",
        "required": ["id", "title", "category", "hypothesis", "mechanism", "sketch", "priority"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$" },
          "title": { "type": "string" },
          "category": { "type": "string", "enum": ["reasoning", "context", "tools", "efficiency", "verification", "planning", "safety"] },
          "hypothesis": { "type": "string", "minLength": 40 },
          "mechanism": { "type": "string" },
          "sketch": { "type": "string" },
          "priority": { "type": "integer", "minimum": 1, "maximum": 5 },
          "expected_effect": { "type": "string", "enum": ["capability", "efficiency", "both"] }
        }
      }
    },
    "requeue": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "reason"],
        "additionalProperties": false,
        "properties": { "id": { "type": "string" }, "reason": { "type": "string" } }
      }
    },
    "config_changes": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["path", "from", "to", "justification"],
        "additionalProperties": false,
        "properties": {
          "path": { "type": "string" },
          "from": {},
          "to": {},
          "justification": { "type": "string" }
        }
      }
    },
    "questions_for_human": { "type": "array", "items": { "type": "string" } }
  }
}
